<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F2">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnAddPetBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="←"
            android:textSize="18sp"
            android:textColor="#152922"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Add Pet Profile"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#152922"/>

        <View android:layout_width="38dp" android:layout_height="38dp"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PHOTO — circular, thick border, white background -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="1000dp"
                app:cardElevation="0dp"
                app:strokeColor="#2F6B52"
                app:strokeWidth="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imgPetPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Pet photo"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/txtPetPhotoLetter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="C"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:textColor="#2F6B52"/>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnAddPetPhoto"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:text="Add Pet Photo"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#2F6B52"
                android:layout_marginBottom="20dp"/>

            <!-- BASIC INFO CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pet Name"
                        android:textSize="11sp"
                        android:textColor="#9C93AD"/>

                    <EditText
                        android:id="@+id/etPetName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Bruno"
                        android:inputType="textCapWords"
                        android:textSize="15sp"
                        android:textColor="#152922"
                        android:background="@null"
                        android:paddingTop="4dp"
                        android:paddingBottom="14dp"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EFF2ED" android:layout_marginBottom="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pet Type"
                        android:textSize="11sp"
                        android:textColor="#9C93AD"/>

                    <Spinner
                        android:id="@+id/spPetType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:paddingBottom="14dp"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EFF2ED" android:layout_marginBottom="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Breed"
                        android:textSize="11sp"
                        android:textColor="#9C93AD"/>

                    <Spinner
                        android:id="@+id/spPetBreed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"/>

                    <EditText
                        android:id="@+id/etCustomBreed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter your pet's breed"
                        android:inputType="textCapWords"
                        android:textSize="14sp"
                        android:textColor="#152922"
                        android:background="@null"
                        android:visibility="gone"
                        android:paddingTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- GENDER + DOB CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gender"
                        android:textSize="11sp"
                        android:textColor="#9C93AD"/>

                    <Spinner
                        android:id="@+id/spPetGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:paddingBottom="14dp"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EFF2ED" android:layout_marginBottom="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date of Birth"
                        android:textSize="11sp"
                        android:textColor="#9C93AD"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/btnPetDob"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Select Date of Birth"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button_green_filled"
                        android:backgroundTint="@null"
                        android:elevation="0dp"/>

                    <TextView
                        android:id="@+id/txtPetAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Age will be calculated from date of birth"
                        android:textSize="12sp"
                        android:textColor="#9C93AD"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- COLOR + WEIGHT CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fur / Coat Color"
                        android:textSize="11sp"
                        android:textColor="#9C93AD"/>

                    <Spinner
                        android:id="@+id/spPetColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:paddingBottom="14dp"/>

                    <EditText
                        android:id="@+id/etCustomColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter fur / coat color"
                        android:inputType="textCapWords"
                        android:textSize="14sp"
                        android:textColor="#152922"
                        android:background="@null"
                        android:visibility="gone"
                        android:paddingBottom="14dp"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EFF2ED" android:layout_marginBottom="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weight (kg)"
                        android:textSize="11sp"
                        android:textColor="#9C93AD"/>

                    <EditText
                        android:id="@+id/etPetWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 5.0"
                        android:inputType="numberDecimal"
                        android:textSize="15sp"
                        android:textColor="#152922"
                        android:background="@null"
                        android:paddingTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SAVE -->
            <Button
                android:id="@+id/btnSavePet"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Create Pet Profile"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_green_filled"
                android:backgroundTint="@null"
                android:elevation="0dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>