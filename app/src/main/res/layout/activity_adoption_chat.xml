<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootAdoptionChat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F2">

    <LinearLayout
        android:id="@+id/chatHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/btnChatBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="←"
            android:textSize="16sp"
            android:textColor="#152922"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:id="@+id/btnChatProfileRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:clickable="true"
            android:focusable="true">

            <androidx.cardview.widget.CardView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="2dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/txtChatAvatarInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="?"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_circle_filled_green"/>

                    <ImageView
                        android:id="@+id/imgChatAvatarPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="Their profile photo"/>

                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/txtChatTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chat"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#152922"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/txtChatSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Adoption chat"
                    android:textSize="10sp"
                    android:textColor="#8A8A8A"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/btnChatMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⋮"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#152922"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:clipToPadding="false"/>

    <TextView
        android:id="@+id/txtPhotoPreviewLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Photo attached — Remove"
        android:textSize="12sp"
        android:textColor="#2F6B52"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <LinearLayout
        android:id="@+id/replyPreviewBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="10dp"
        android:visibility="gone">

        <View android:layout_width="4dp" android:layout_height="34dp" android:background="#2F6B52"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/txtReplyBarSender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#2F6B52"/>

            <TextView
                android:id="@+id/txtReplyBarText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#4B5C54"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnCancelReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textSize="16sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/btnAttachPhoto"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="📎"
            android:textSize="18sp"
            android:background="@drawable/bg_chip_purple"
            android:clickable="true"
            android:focusable="true"/>

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:hint="Type a message..."
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_input_pill"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/btnSendMessage"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:text="Send"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_green_filled"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>