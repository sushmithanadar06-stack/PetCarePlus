<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootChatRoom"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnChatBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="←"
            android:textSize="18sp"
            android:textColor="#152922"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/txtChatRoomName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Chat"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#152922"/>

        <View
            android:layout_width="38dp"
            android:layout_height="38dp"/>

    </LinearLayout>


    <TextView
        android:id="@+id/txtHealthDisclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Community advice is not a substitute for professional veterinary care. For medical concerns, please consult a licensed vet."
        android:textSize="11sp"
        android:textColor="#8A6D3B"
        android:background="#FCF3D9"
        android:padding="12dp"
        android:lineSpacingExtra="2dp"
        android:visibility="gone"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:clipToPadding="false"/>


    <TextView
        android:id="@+id/txtNoMessages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No messages yet — start the conversation"
        android:textSize="13sp"
        android:textColor="#8A8A8A"
        android:padding="30dp"
        android:visibility="gone"/>


    <LinearLayout
        android:id="@+id/selectedPhotoPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgSelectedPreview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:contentDescription="Selected photo"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Photo attached"
            android:textSize="12sp"
            android:textColor="#152922"
            android:layout_marginStart="12dp"/>

        <TextView
            android:id="@+id/btnRemovePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remove"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#F2704A"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>


    <!-- REPLY PREVIEW BAR -->

    <LinearLayout
        android:id="@+id/replyPreviewBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="10dp"
        android:visibility="gone">

        <View
            android:layout_width="4dp"
            android:layout_height="34dp"
            android:background="#2F6B52"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/txtReplyBarSender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#2F6B52"/>

            <TextView
                android:id="@+id/txtReplyBarText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#4B5C54"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

        <TextView
            android:id="@+id/btnCancelReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textSize="16sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>


    <!-- MESSAGE INPUT ROW -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="8dp">

        <TextView
            android:id="@+id/btnAttachPhoto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="📎"
            android:textSize="18sp"
            android:background="@drawable/bg_chip_purple"
            android:clickable="true"
            android:focusable="true"/>


        <!-- UPDATED MESSAGE INPUT -->

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_weight="1"
            android:hint="Type a message..."
            android:textSize="13sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_input_pill"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionNone"
            android:maxLines="4"/>


        <TextView
            android:id="@+id/btnSendMessage"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="Send"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_green_filled"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>