<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnCommunityBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="←"
            android:textSize="18sp"
            android:textColor="#152922"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Community"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#152922"/>

        <View android:layout_width="38dp" android:layout_height="38dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btnTabAdoption"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Adoption"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2F6B52"
            android:background="@drawable/bg_chip_purple"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnTabChatRooms"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Chat Rooms"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_green_filled"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHAT ROOMS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#9C93AD"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/roomsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Messages and photos are automatically removed after 24 hours (7 days in Lost &amp; Found)."
                android:textSize="11sp"
                android:textColor="#9C93AD"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>