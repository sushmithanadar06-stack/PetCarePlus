<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F2">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnFoodSafetyBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="←"
            android:textSize="18sp"
            android:textColor="#152922"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Food Safety Checker"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#152922" />

        <View
            android:layout_width="38dp"
            android:layout_height="38dp" />

    </LinearLayout>

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btnTabChecker"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Checker"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_green_filled"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnTabNutrition"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Nutrition"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#2F6B52"
            android:background="@drawable/bg_chip_purple"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnTabSnacks"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Snacks"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#2F6B52"
            android:background="@drawable/bg_chip_purple"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Food Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etFoodSearch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Search a food..."
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp"
            android:background="@drawable/bg_input_field" />

        <TextView
            android:id="@+id/btnCheckFood"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Check"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_green_filled"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginStart="10dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Suggestions -->
            <LinearLayout
                android:id="@+id/suggestionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />

            <!-- Recently Checked -->
            <TextView
                android:id="@+id/txtRecentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECENTLY CHECKED"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#9C93AD"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/recentListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/txtNoRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No foods checked yet"
                android:textSize="13sp"
                android:textColor="#8A8A8A"
                android:padding="20dp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
