<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F6F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- APP LOGO (dog + cat + PetCare+ name + tagline) -->
            <ImageView
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/logo_petcare"
                android:contentDescription="PetCare+ logo"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email or phone"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#4B5C54"
                android:layout_marginBottom="5dp"
                android:paddingStart="4dp"/>

            <EditText
                android:id="@+id/etLoginEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="aisha@example.com"
                android:textColorHint="#B0B7B3"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="12sp"
                android:background="@drawable/bg_input_pill"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#4B5C54"
                android:layout_marginBottom="5dp"
                android:paddingStart="4dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="6dp">

                <EditText
                    android:id="@+id/etLoginPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="••••••••"
                    android:textColorHint="#B0B7B3"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="52dp"
                    android:textSize="12sp"
                    android:background="@drawable/bg_input_pill"/>

                <ImageView
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_eye_closed"
                    android:contentDescription="Toggle password visibility"
                    android:clickable="true"
                    android:focusable="true"/>

            </FrameLayout>

            <TextView
                android:id="@+id/txtForgotPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forgot password?"
                android:textSize="11sp"
                android:textColor="#2F6B52"
                android:textStyle="bold"
                android:gravity="end"
                android:padding="6dp"
                android:layout_marginBottom="18dp"/>

            <Button
                android:id="@+id/btnLogin"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Log In"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_primary"
                android:elevation="0dp"/>

            <TextView
                android:id="@+id/txtGoToSignup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New here? Create account"
                android:textSize="11sp"
                android:textColor="#4B5C54"
                android:layout_marginTop="16dp"
                android:padding="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp">

                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" android:background="#DEE5DD"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  OR  "
                    android:textSize="10sp"
                    android:textColor="#9C93AD"/>

                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" android:background="#DEE5DD"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnGuestLogin"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Continue as Guest"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_primary"
                android:elevation="0dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Guest data is not saved to the cloud"
                android:textSize="9sp"
                android:textColor="#9C93AD"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="By continuing you agree to our Terms &amp; Privacy Policy"
                android:textSize="9sp"
                android:textColor="#9C93AD"
                android:gravity="center"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>