<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F2">

    <!-- Top Action Bar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnMoodBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="←"
            android:textSize="18sp"
            android:textColor="#152922"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Mood Journal"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#152922" />

        <View
            android:layout_width="38dp"
            android:layout_height="38dp" />

    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Question -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How's your pet feeling today?"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#8A8A8A"
                android:layout_marginBottom="14dp" />

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <!-- Happy -->
                <LinearLayout
                    android:id="@+id/moodHappy"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtMoodEmojiHappy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Happy"
                        android:textSize="12sp"
                        android:textColor="#152922" />

                </LinearLayout>

                <!-- Playful -->
                <LinearLayout
                    android:id="@+id/moodPlayful"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtMoodEmojiPlayful"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Playful"
                        android:textSize="12sp"
                        android:textColor="#152922" />

                </LinearLayout>

                <!-- Neutral -->
                <LinearLayout
                    android:id="@+id/moodNeutral"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtMoodEmojiNeutral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Neutral"
                        android:textSize="12sp"
                        android:textColor="#152922" />

                </LinearLayout>

            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Tired -->
                <LinearLayout
                    android:id="@+id/moodTired"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtMoodEmojiTired"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tired"
                        android:textSize="12sp"
                        android:textColor="#152922" />

                </LinearLayout>

                <!-- Sad -->
                <LinearLayout
                    android:id="@+id/moodSad"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtMoodEmojiSad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sad"
                        android:textSize="12sp"
                        android:textColor="#152922" />

                </LinearLayout>

                <!-- Sick -->
                <LinearLayout
                    android:id="@+id/moodSick"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtMoodEmojiSick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sick"
                        android:textSize="12sp"
                        android:textColor="#152922" />

                </LinearLayout>

            </LinearLayout>

            <!-- History Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mood History"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#8A8A8A"
                android:layout_marginBottom="12dp" />

            <!-- Empty History Message -->
            <TextView
                android:id="@+id/txtNoMoodLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No mood entries yet."
                android:textSize="13sp"
                android:textColor="#8A8A8A"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone" />

            <!-- History List -->
            <LinearLayout
                android:id="@+id/moodLogList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>