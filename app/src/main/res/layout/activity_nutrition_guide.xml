<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8F6">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnNutritionBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="←"
            android:textSize="18sp"
            android:textColor="#152922"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Nutrition Guide"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#152922"/>

        <View
            android:layout_width="38dp"
            android:layout_height="38dp"/>

    </LinearLayout>

    <!-- TABS: Checker / Guide / Snacks -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/btnTabChecker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp"
            android:text="Food Checker"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#8A8A8A"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:padding="10dp"
            android:text="Guide"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_circle_green"/>

        <TextView
            android:id="@+id/btnTabSnacks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:padding="10dp"
            android:text="Pet Snacks"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#8A8A8A"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- DOG SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐶 Dog Nutrition by Life Stage"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#152922"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/dogNutritionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"/>

            <!-- CAT SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐱 Cat Nutrition by Life Stage"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#152922"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/catNutritionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"/>

            <!-- GENERAL TIPS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 General Feeding Tips"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#152922"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/generalTipsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>