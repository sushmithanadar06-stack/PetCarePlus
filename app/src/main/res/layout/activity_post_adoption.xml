<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/btnPostBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="←"
                android:textSize="18sp"
                android:textColor="#152922"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/txtPostTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Post for Adoption"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#152922"/>

            <View android:layout_width="38dp" android:layout_height="38dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photos (up to 4)"
                android:textSize="11sp"
                android:textColor="#9C93AD"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/photoThumbsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etPetName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Pet name"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etBreed"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Breed"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etAge"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Age (e.g. 1 yr)"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/bg_input_field"/>

                <Spinner
                    android:id="@+id/spGender"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_input_field"/>

            </LinearLayout>

            <EditText
                android:id="@+id/etReason"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="Reason for rehoming..."
                android:gravity="top"
                android:padding="14dp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Your location"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnSubmitPost"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Post to Community"
                android:textColor="@android:color/white"
                android:backgroundTint="#2F6B52"/>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>