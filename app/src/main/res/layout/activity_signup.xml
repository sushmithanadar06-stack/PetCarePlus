<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/btnSignupBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="←"
            android:textSize="18sp"
            android:textColor="#152922"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#152922"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <!-- FULL NAME -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full name"
            android:textSize="12sp"
            android:textColor="#4B5C54"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etSignupName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Your name"
            android:inputType="textCapWords"
            android:background="@drawable/bg_input_field"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="15sp"
            android:textColor="#152922"
            android:layout_marginBottom="18dp"/>

        <!-- EMAIL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="12sp"
            android:textColor="#4B5C54"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etSignupEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="you@example.com"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_input_field"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="15sp"
            android:textColor="#152922"
            android:layout_marginBottom="18dp"/>

        <!-- PHONE NUMBER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone number"
            android:textSize="12sp"
            android:textColor="#4B5C54"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_field"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+91"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#152922"/>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#D0D5CE"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>

            <EditText
                android:id="@+id/etSignupPhone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="10-digit phone number"
                android:inputType="number"
                android:maxLength="10"
                android:textSize="15sp"
                android:textColor="#152922"/>

        </LinearLayout>

        <!-- STATE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="State"
            android:textSize="12sp"
            android:textColor="#4B5C54"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etSignupState"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Mumbai"
            android:inputType="textCapWords"
            android:background="@drawable/bg_input_field"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="15sp"
            android:textColor="#152922"
            android:layout_marginBottom="18dp"/>

        <!-- PASSWORD -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="12sp"
            android:textColor="#4B5C54"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etSignupPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="At least 6 characters"
            android:inputType="textPassword"
            android:background="@drawable/bg_input_field"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="15sp"
            android:textColor="#152922"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnSignup"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Sign Up"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_green_filled"
            android:backgroundTint="@null"
            android:elevation="0dp"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="By continuing you agree to our Terms &amp; Privacy Policy"
            android:textSize="11sp"
            android:textColor="#8A8A8A"
            android:gravity="center"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:id="@+id/txtGoToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Already have an account? Log In"
            android:textSize="13sp"
            android:textColor="#2F6B52"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>