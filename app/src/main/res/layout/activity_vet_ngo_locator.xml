<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootVetLocator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7FBF8">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/btnLocatorBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="32sp"
            android:textColor="#2F6B52"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/txtLocatorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Vet &amp; NGO Locator"
            android:textColor="#152922"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- VET / NGO / ADD TABS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btnTabVets"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Vets"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_green_filled"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnTabNgos"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="NGOs"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2F6B52"
            android:background="@drawable/bg_chip_purple"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnAddVetNgo"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="+"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_green_filled"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- LOCATION LIST -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/locationsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"/>

    </ScrollView>

</LinearLayout>