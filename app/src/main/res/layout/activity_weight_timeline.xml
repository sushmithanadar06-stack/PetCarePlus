<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnWeightBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="←"
            android:textSize="18sp"
            android:textColor="#152922"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Weight Tracker"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#152922"/>

        <View android:layout_width="38dp" android:layout_height="38dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- STATUS CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:backgroundTint="#1E5C45"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/txtWeightVerdict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Perfect weight"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/txtWeightVerdictDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Target range for this age: 3.4 – 4.6 kg"
                    android:textSize="12sp"
                    android:textColor="#CFE3D8"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>

            <!-- LOG NEW WEIGHT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log new weight"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#8A8A8A"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/etNewWeight"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Weight in kg"
                    android:inputType="numberDecimal"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/btnSaveWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button_green_filled"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"/>

            </LinearLayout>

            <!-- HISTORY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#8A8A8A"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/weightHistoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <TextView
                android:id="@+id/txtNoHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No weight logs yet"
                android:textSize="13sp"
                android:textColor="#8A8A8A"
                android:padding="20dp"
                android:visibility="gone"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>