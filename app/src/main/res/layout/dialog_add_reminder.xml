<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/etReminderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. Feed Chellu"
        android:inputType="textCapSentences"
        android:layout_marginBottom="14dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Type"
        android:textSize="12sp"
        android:textColor="#4B5C54"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/spReminderType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"/>

    <Button
        android:id="@+id/btnPickDateTime"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Pick Date &amp; Time"
        android:textColor="@android:color/white"
        android:backgroundTint="#2F6B52"
        android:layout_marginBottom="14dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Repeat"
        android:textSize="12sp"
        android:textColor="#4B5C54"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/spReminderRepeat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"/>

    <EditText
        android:id="@+id/etReminderNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Notes (optional)"
        android:inputType="textCapSentences"/>

</LinearLayout>