<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp">

    <EditText android:id="@+id/etVetTitle" android:layout_width="match_parent" android:layout_height="48dp"
        android:hint="Doctor / clinic (e.g. Dr. Menon — Checkup)" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:background="@drawable/bg_input_pill" android:layout_marginBottom="12dp"/>

    <EditText android:id="@+id/etVetAddress" android:layout_width="match_parent" android:layout_height="48dp"
        android:hint="Clinic address" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:background="@drawable/bg_input_pill" android:layout_marginBottom="12dp"/>

    <EditText android:id="@+id/etVetHours" android:layout_width="match_parent" android:layout_height="48dp"
        android:hint="Hours (e.g. 9:00 AM – 8:00 PM) — optional" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:background="@drawable/bg_input_pill" android:layout_marginBottom="12dp"/>

    <EditText android:id="@+id/etVetPhone" android:layout_width="match_parent" android:layout_height="48dp"
        android:hint="Contact number — optional" android:inputType="phone"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:background="@drawable/bg_input_pill" android:layout_marginBottom="12dp"/>

    <Button android:id="@+id/btnVetDate" android:layout_width="match_parent" android:layout_height="48dp"
        android:text="Select Visit Date" android:textColor="@android:color/white"
        android:background="@drawable/bg_button_primary" android:backgroundTint="@null"
        android:layout_marginBottom="4dp"/>
</LinearLayout>