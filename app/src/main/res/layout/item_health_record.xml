<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtRecordIcon"
            android:layout_width="42dp" android:layout_height="42dp"
            android:gravity="center" android:textSize="16sp"
            android:background="@drawable/bg_chip_purple"/>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="14dp">

            <TextView android:id="@+id/txtRecordTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:textColor="#152922"/>
            <TextView android:id="@+id/txtRecordSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#9C93AD" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtRecordBadge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:textStyle="bold" android:textColor="#FFFFFF"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:background="@drawable/bg_badge_pill"
            android:visibility="gone"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>