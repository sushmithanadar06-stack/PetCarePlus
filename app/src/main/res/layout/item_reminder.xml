<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/txtReminderIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:textSize="18sp"
        android:background="@drawable/bg_chip_purple"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/txtReminderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feed Chellu"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#152922"/>

        <TextView
            android:id="@+id/txtReminderSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mon, Sep 08 · 8:00 AM"
            android:textSize="11sp"
            android:textColor="#8A8A8A"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/txtReminderRepeat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daily"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#2F6B52"
        android:background="@drawable/bg_chip_purple"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone"/>

</LinearLayout>